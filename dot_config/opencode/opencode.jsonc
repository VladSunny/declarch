{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-vllm/qwen2.5-3b-instruct",
  "providers": {
    "local-vllm": {
      "name": "Local vLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
      },
      "models": {
        "qwen2.5-3b-instruct": {
          "name": "Qwen 2.5 3B Instruct",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
          },
          "limit": {
            "context": 32768,
            "output": 8192,
          },
        },
      },
    },
  },
}
