{
  "$schema": "https://opencode.ai/config.json",

  "update": "notify",
  "default_agent": "build",
  "formatter": true,

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".next/**"
    ]
  },

  "agents": {
    "plan": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.2-astra",
        "variant": "medium"
      }
    },
    "build": {
      "model": {
        "providerID": "openai",
        "model": "gpt-6.2-sol",
        "variant": "low"
      }
    }
  }
}
