{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cava"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "group/expand",
    "tray",
    "pulseaudio#source",
    "memory",
    "disk",
    "clock"
  ],
  "reload_style_on_change": true,

  "include": "~/.config/waybar/modules.jsonc"
}