{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "arch_small",
        "padding": {
            "left": 1,
            "right": 3
        },
        "color": {
            "1": "#B7A7D8",
            "2": "#8FAA9A",
            "3": "#778093"
        }
    },
    "display": {
        "separator": " › ",
        "brightColor": false,
        "color": {
            "keys": "#ADB5C5",
            "title": "#B7A7D8",
            "output": "#D5DAE5",
            "separator": "#778093"
        }
    },
    "modules": [
        "title",
        "packages",
        "kernel",
        "uptime",
        "battery",
        "memory",
        "gpu",
        "cpu"
    ]
}
