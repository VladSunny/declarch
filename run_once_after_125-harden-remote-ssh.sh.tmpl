{{- if and (eq .chezmoi.hostname "declarch-pc") (eq .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash

set -euo pipefail

SSHD_CONFIG="/etc/ssh/sshd_config.d/60-remote-access.conf"
FAIL2BAN_CONFIG="/etc/fail2ban/jail.d/sshd.local"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
SSHD_SOURCE="$SOURCE_DIR/system-config/ssh/60-remote-access.conf"
FAIL2BAN_SOURCE="$SOURCE_DIR/system-config/fail2ban/sshd.local"
SSHD_BACKUP=""
FAIL2BAN_BACKUP=""

fail() {
    echo "Remote SSH hardening failed: $*" >&2
    exit 1
}

restore_configs() {
    local status=$?

    if (( status != 0 )) && [[ -n "$SSHD_BACKUP" ]]; then
        echo "Restoring the previous SSHD drop-in after validation failure..." >&2
        if [[ "$SSHD_BACKUP" == "absent" ]]; then
            sudo rm -f -- "$SSHD_CONFIG"
        else
            sudo install -m 0644 "$SSHD_BACKUP" "$SSHD_CONFIG"
            rm -f -- "$SSHD_BACKUP"
        fi
    fi

    if (( status != 0 )) && [[ -n "$FAIL2BAN_BACKUP" ]]; then
        echo "Restoring the previous fail2ban jail after validation failure..." >&2
        if [[ "$FAIL2BAN_BACKUP" == "absent" ]]; then
            sudo rm -f -- "$FAIL2BAN_CONFIG"
        else
            sudo install -m 0644 "$FAIL2BAN_BACKUP" "$FAIL2BAN_CONFIG"
            rm -f -- "$FAIL2BAN_BACKUP"
        fi
    fi

    exit "$status"
}

require_command() {
    local command_name="$1"

    command -v "$command_name" >/dev/null 2>&1 || fail "required command '$command_name' is unavailable after metapac sync."
}

trap restore_configs EXIT

if (( EUID == 0 )); then
    fail "run chezmoi as a regular user, not root."
fi

require_command sshd
require_command ssh-keygen
require_command fail2ban-client
require_command systemctl
require_command sudo

[[ -f "$SSHD_SOURCE" ]] || fail "missing source file '$SSHD_SOURCE'."
[[ -f "$FAIL2BAN_SOURCE" ]] || fail "missing source file '$FAIL2BAN_SOURCE'."

sudo install -d -m 0755 /etc/ssh/sshd_config.d /etc/fail2ban/jail.d

echo "Ensuring SSH host keys exist..."
sudo ssh-keygen -A

if sudo test -f "$SSHD_CONFIG"; then
    SSHD_BACKUP="$(mktemp)"
    sudo cat "$SSHD_CONFIG" > "$SSHD_BACKUP"
else
    SSHD_BACKUP="absent"
fi

sudo install -m 0644 "$SSHD_SOURCE" "$SSHD_CONFIG"
echo "Validating SSHD configuration..."
sudo sshd -t

if sudo test -f "$FAIL2BAN_CONFIG"; then
    FAIL2BAN_BACKUP="$(mktemp)"
    sudo cat "$FAIL2BAN_CONFIG" > "$FAIL2BAN_BACKUP"
else
    FAIL2BAN_BACKUP="absent"
fi

sudo install -m 0644 "$FAIL2BAN_SOURCE" "$FAIL2BAN_CONFIG"
echo "Validating fail2ban configuration..."
sudo fail2ban-client -d >/dev/null

if [[ "$SSHD_BACKUP" != "absent" ]]; then
    rm -f -- "$SSHD_BACKUP"
fi
SSHD_BACKUP=""
if [[ "$FAIL2BAN_BACKUP" != "absent" ]]; then
    rm -f -- "$FAIL2BAN_BACKUP"
fi
FAIL2BAN_BACKUP=""

echo "Enabling remote access services..."
sudo systemctl enable --now fail2ban.service
for attempt in {1..10}; do
    if sudo fail2ban-client ping >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
sudo fail2ban-client ping >/dev/null || fail "fail2ban did not become ready within 10 seconds."
sudo fail2ban-client reload
sudo fail2ban-client status sshd >/dev/null
sudo systemctl enable --now sshd.service
sudo systemctl reload sshd.service
echo "Remote SSH hardening completed successfully."
{{- end }}
