{{- if and (or (eq .chezmoi.hostname "declarch-pc") (eq .chezmoi.hostname "declarch-laptop")) (eq .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash

set -euo pipefail

fail() {
    echo "Metapac sync failed: $*" >&2
    exit 1
}

if (( EUID == 0 )); then
    fail "run chezmoi as a regular user, not root."
fi

command -v metapac >/dev/null 2>&1 || fail "required command 'metapac' is unavailable."

echo "Ensuring npm user prefix directories..."
install -d -m 0755 \
    "$HOME/.local/bin" \
    "$HOME/.local/lib" \
    "$HOME/.local/share" \
    "$HOME/.npm" \
    "$HOME/.npm/_logs"

echo "Synchronizing the metapac profile..."
metapac sync --no-confirm

echo "Metapac sync completed successfully."
{{- end }}
